{
    // cajeta-cloud-cloudflare — the Cloudflare adapters for dev.cajeta.cloud's
    // ports (cajeta-cloud-cloudflare spec): R2 behind the object store through
    // the shared S3 client (dev.cajeta.cloud.s3), Cloudflare Access as a token
    // verifier, Queues behind the queue port and Workers KV behind the
    // key-value port, all over cajeta-http.
    //
    // Capabilities: `network` for the service endpoints and `env` for the
    // configuration chain (CLOUDFLARE_* and R2_* variables; spec §7). No
    // filesystem: Cloudflare has no credentials file.

    "details": {
        "name":               "dev.cajeta.cloud.cloudflare",
        "version":            "0.1.0",
        "description":        "cajeta-cloud-cloudflare — R2, Access, Queues and Workers KV adapters for dev.cajeta.cloud over cajeta-http",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "toolchain": {
            "version": "0.48.0"
        },

        "capabilities": ["env", "network"],

        // cloud 0.5.0 carries the queue and key-value ports (spec Q2); cloud.s3
        // 0.1.0 is the S3 client R2 is reached through. http, codec and crypto
        // are the transport, the XML and JSON readers, and the JWT signatures
        // (Access). A bare version is a floor within its major.
        "dependencies": {
            "dev.cajeta.cloud":    "0.5.1",
            "dev.cajeta.cloud.s3": "0.1.0",
            "dev.cajeta.http":     "0.9.1",
            "dev.cajeta.codec":    "0.9.1",
            "dev.cajeta.crypto":   "0.2.0"
        },

        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.6"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm", "args": ["-rf", "build"] }
            ]
        }
    }
}
