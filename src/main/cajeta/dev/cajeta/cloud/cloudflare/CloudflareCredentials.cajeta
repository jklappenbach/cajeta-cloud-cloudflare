package dev.cajeta.cloud.cloudflare;

import cajeta.lang.String;

/**
 * What the REST adapters (Queues, Workers KV) authenticate with: the account
 * id and an API token. R2's S3 API uses an `S3Credentials` pair instead.
 * `toString` names the account only.
 */
public final class CloudflareCredentials {
    String account;
    String token;

    public CloudflareCredentials(String accountId, String apiToken) {
        this.account = "" + accountId;
        this.token = "" + apiToken;
        return;
    }

    public String accountId() { return this.account; }
    public String apiToken() { return this.token; }

    public #String toString() {
        return "CloudflareCredentials(" + this.account + ")";
    }
}
