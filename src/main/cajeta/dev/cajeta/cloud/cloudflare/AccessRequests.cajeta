package dev.cajeta.cloud.cloudflare;

import cajeta.lang.String;
import dev.cajeta.cloud.identity.Claims;
import dev.cajeta.cloud.identity.TokenUse;
import dev.cajeta.cloud.identity.TokenVerifier;
import dev.cajeta.http.HttpRequest;

/**
 * The Access token on a request behind Access (spec 4.1): the
 * `Cf-Access-Jwt-Assertion` header, else the `CF_Authorization` cookie. A
 * request with neither is unauthenticated, which is null here, not an error;
 * a request with a token that fails verification is refused like any other.
 */
public final class AccessRequests {

    /** The token on `r`, or null when it carries none. */
    public static #String tokenOf(HttpRequest r) {
        if (r.hasHeader("cf-access-jwt-assertion")) {
            String h #= r.headerString("cf-access-jwt-assertion");
            if (h.byteLength() > 0) return #h;
        }
        if (!r.hasHeader("cookie")) return null;
        String cookies #= r.headerString("cookie");
        int64 at = 0L;
        int64 len = cookies.byteLength();
        while (at < len) {
            int64 semi = cookies.indexOfFrom(";", at);
            if (semi < 0L) semi = len;
            String raw #= cookies.substring((int32) at, (int32) semi);
            String pair #= raw.trim();
            at = semi + 1L;
            int64 eq = pair.indexOf("=");
            if (eq < 0L) continue;
            String name #= pair.substring(0, (int32) eq);
            if (!name.equals("CF_Authorization")) continue;
            String value #= pair.substring((int32) (eq + 1L), pair.byteLength());
            if (value.byteLength() > 0) return #value;
        }
        return null;
    }

    /** The verified claims of the token on `r`, or null when it carries none. */
    public static #Claims verify(TokenVerifier verifier, HttpRequest r) {
        String token #= AccessRequests.tokenOf(r);
        if (token == null) return null;
        return verifier.verify(token, TokenUse.ACCESS());
    }
}
